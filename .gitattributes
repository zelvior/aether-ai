# Git attributes — https://git-scm.com/docs/gitattributes
#
# Goals:
#   1. Normalize text files to LF in the repository so builds and checks are
#      reproducible across platforms.
#   2. Keep the repository free of binary blobs that should not be committed.
#   3. Make diffs readable for generated or vendor-looking content.

# --- Defaults -------------------------------------------------------------

* text=auto eol=lf

# --- Explicit text types --------------------------------------------------

*.md        text eol=lf
*.txt       text eol=lf
*.c         text eol=lf
*.h         text eol=lf
*.cc        text eol=lf
*.cpp       text eol=lf
*.hpp       text eol=lf
*.py        text eol=lf
*.sh        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.json      text eol=lf
*.cff       text eol=lf
*.toml      text eol=lf
*.cmake     text eol=lf
Makefile    text eol=lf
LICENSE     text eol=lf
NOTICE      text eol=lf
AUTHORS     text eol=lf

# --- Explicit binary types ------------------------------------------------

# Model weights, tokenizer assets, and datasets are NOT tracked in this
# repository at this stage. The lines below only prevent accidental corruption
# if such files are ever added deliberately. Their licensing is governed by
# docs/LICENSE_POLICY.md and docs/DATA_POLICY.md.
*.bin       binary
*.aet       binary
*.safetensors binary
*.onnx      binary
*.pt        binary
*.gguf      binary
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.pdf       binary
*.zip       binary
*.tar       binary
*.gz        binary
*.xz        binary

# --- Diff behaviour -------------------------------------------------------

*.md        diff=markdown
*.pdf       diff=astextplain

# --- Linguist -------------------------------------------------------------
# Generated or vendored content should not dominate repository language stats.

docs/**     linguist-documentation
